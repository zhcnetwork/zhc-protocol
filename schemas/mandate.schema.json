{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhc.network/schemas/0.2/mandate.schema.json",
  "$comment": "Wire version 0.2, specification revision 0.2.1. Revisions add optional fields only.",
  "title": "ZHC Mandate v0.2",
  "description": "A signed grant of business authority from an issuer to an agent. Evaluation fails closed (PROTOCOL §3.1).",
  "type": "object",
  "required": [
    "zhc",
    "id",
    "issuer",
    "subject",
    "issued_at",
    "expires_at",
    "scopes",
    "escalation"
  ],
  "properties": {
    "zhc": {
      "const": "0.2"
    },
    "id": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "parent": {
      "type": "string",
      "description": "Delegation parent: the mandate whose subject issued this one (PROTOCOL §3.2)."
    },
    "supersedes": {
      "type": "string",
      "description": "An earlier version of the same grant that this one replaces. Not a delegation link."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "to",
        "timeout_s",
        "on_timeout"
      ],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 0
        },
        "on_timeout": {
          "enum": [
            "deny",
            "allow"
          ]
        }
      }
    },
    "progression": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "then"
        ],
        "properties": {
          "when": {
            "oneOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              }
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "action",
              "set"
            ],
            "properties": {
              "action": {
                "$ref": "#/$defs/action"
              },
              "set": {
                "type": "object",
                "description": "New values for the target scope. May not change its action or area.",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "action"
                      ]
                    },
                    {
                      "required": [
                        "domain"
                      ]
                    }
                  ]
                }
              },
              "domain": {
                "type": "string",
                "description": "The target scope's area. Omitted: the area-less scope."
              }
            }
          },
          "note": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "widen",
              "narrow"
            ],
            "description": "A widen rule never narrows (once satisfied it does nothing); a narrow rule never widens."
          }
        }
      },
      "description": "Rules that change scopes when conditions hold. A rule with any self-sourced condition may only narrow authority (PROTOCOL §3.3)."
    },
    "bindings": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "description": "Issuer's Ed25519 signature over the canonical JSON of the mandate without this member (PROTOCOL §3.5).",
      "required": [
        "alg",
        "kid",
        "sig"
      ],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "description": "Key id, resolved from the manifest's signing_keys or the issuer's DID document."
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url, no padding."
        }
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Integer minor units (cents for USD)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,5}$"
        }
      }
    },
    "action": {
      "enum": [
        "money.spend",
        "money.collect",
        "money.refund",
        "money.vendor_payment",
        "money.reserve",
        "pricing.change",
        "decision.make",
        "service.deliver",
        "network.buy",
        "network.sell",
        "process.change",
        "attestation.issue"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "domain": {
          "type": "string"
        },
        "tier_max": {
          "enum": [
            "tactical",
            "operational",
            "strategic"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "per_action": {
              "$ref": "#/$defs/money"
            },
            "per_day": {
              "$ref": "#/$defs/money"
            },
            "per_month": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "require_approval_over": {
          "$ref": "#/$defs/money"
        },
        "max_relative_change": {
          "type": "number",
          "minimum": 0
        },
        "counterparty": {
          "type": "object",
          "properties": {
            "min_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "min_integrity": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "min_assurance": {
              "enum": [
                "claimed",
                "provisional",
                "measured",
                "attested"
              ]
            }
          },
          "description": "The buyer's minimums for a counterparty, enforced like any other limit. A ZH level isn't evidence of capacity to pay or perform (PROTOCOL §7)."
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "metric",
        "op",
        "value"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "=="
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "source": {
          "enum": [
            "self",
            "attestation",
            "processor"
          ],
          "default": "self",
          "description": "Where the fact comes from. self = anything the company computes or records, including its own score; attestation = a verified attestation from an independent validator; processor = figures from a payment processor or custodian."
        }
      }
    }
  }
}
