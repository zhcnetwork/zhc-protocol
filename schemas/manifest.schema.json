{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhc.network/schemas/0.2/manifest.schema.json",
  "$comment": "Wire version 0.2, specification revision 0.2.1. Revisions add optional fields only.",
  "title": "ZHC Company Manifest v0.2",
  "description": "Published at /.well-known/zhc.json. Declares who the company is, who answers for it, and its agents.",
  "type": "object",
  "required": [
    "zhc",
    "id",
    "name",
    "legal",
    "accountable_human",
    "charter",
    "domains",
    "agents"
  ],
  "properties": {
    "zhc": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "legal": {
      "type": "object",
      "required": [
        "entity_name",
        "jurisdiction"
      ],
      "properties": {
        "entity_name": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "registration_id": {
          "type": "string"
        }
      }
    },
    "accountable_human": {
      "type": "object",
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string",
          "description": "SHOULD be a role address, not a personal one."
        }
      }
    },
    "charter": {
      "type": "object",
      "required": [
        "mission",
        "reserved_to_human",
        "prohibited"
      ],
      "properties": {
        "mission": {
          "type": "string"
        },
        "reserved_to_human": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "description": "Full charter. SHOULD name a successor, or a procedure, for when the accountable human can't act."
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "products": {
          "type": "integer",
          "minimum": 0
        },
        "markets": {
          "type": "integer",
          "minimum": 0
        },
        "business_models": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Declared by the company. Not checked against evidence in v0.2.1 (MODEL §6)."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "domain"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "agent_card": {
            "type": "string",
            "format": "uri"
          },
          "erc8004": {
            "type": "string",
            "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}:[0-9]+$"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "endpoint",
          "protocol"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "protocol": {
            "enum": [
              "a2a",
              "mcp",
              "http"
            ]
          },
          "price": {
            "$ref": "#/$defs/money"
          },
          "rails": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rail"
            }
          }
        }
      },
      "description": "Services offered to others. A priced service makes refund conduct applicable (MODEL §5)."
    },
    "mandates_uri": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "required": [
        "uri",
        "format"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "format": {
          "const": "zhc-events/0.2"
        }
      }
    },
    "parent": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "properties": {
        "claimed": {
          "type": "string"
        },
        "attestations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validator_keys": {
      "type": "array",
      "description": "Public keys this company signs attestations with, if it acts as a validator (PROTOCOL §6.2), and nothing else.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "alg",
          "public_key_pem"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "alg": {
            "const": "Ed25519"
          },
          "public_key_pem": {
            "type": "string"
          }
        }
      }
    },
    "signing_keys": {
      "type": "array",
      "description": "Public keys that sign this company's mandates (PROTOCOL §3.5), and nothing else. `holder` is the issuer id used in mandates, e.g. human:owner, or an agent id that delegates.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "holder",
          "alg",
          "public_key_pem"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "holder": {
            "type": "string"
          },
          "alg": {
            "const": "Ed25519"
          },
          "public_key_pem": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Integer minor units (cents for USD)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,5}$"
        }
      }
    },
    "rail": {
      "enum": [
        "stripe",
        "x402",
        "mpp",
        "ap2",
        "acp",
        "ledger",
        "other"
      ]
    }
  }
}
