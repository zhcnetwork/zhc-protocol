{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhc.network/schemas/0.2/attestation.schema.json",
  "$comment": "Wire version 0.2, specification revision 0.2.1. Revisions add optional fields only.",
  "title": "ZH Attestation v0.2",
  "description": "A validator-signed ZH profile over a specific evidence head. Ed25519 over the canonical JSON of the payload. Verify only with a key resolved from the issuer's manifest or DID document (PROTOCOL §6.2).",
  "type": "object",
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "type",
        "spec",
        "method",
        "issuer",
        "subject",
        "profile",
        "evidence",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "ZHAttestation"
        },
        "spec": {
          "const": "0.2"
        },
        "method": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "kid": {
          "type": "string",
          "description": "Key id the issuer signed with; resolve it from the issuer's validator_keys."
        },
        "subject": {
          "type": "string"
        },
        "profile": {
          "type": "object",
          "required": [
            "spec",
            "company",
            "level",
            "axes",
            "scope",
            "integrity",
            "assurance"
          ],
          "properties": {
            "spec": {
              "const": "0.2"
            },
            "method": {
              "type": "string",
              "description": "Scoring method, e.g. zhc-score/0.2.1."
            },
            "company": {
              "type": "string"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "axes": {
              "type": "object",
              "required": [
                "O",
                "D",
                "F",
                "R",
                "N"
              ],
              "properties": {
                "O": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "D": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "F": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "R": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "N": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              }
            },
            "scope": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "scope_basis": {
              "const": "declared"
            },
            "integrity": {
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "U"
              ]
            },
            "assurance": {
              "enum": [
                "claimed",
                "provisional",
                "measured",
                "attested"
              ]
            },
            "window": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "days": {
                  "type": "number"
                },
                "events": {
                  "type": "integer"
                }
              }
            },
            "limited_by": {
              "type": "array",
              "description": "Axes holding the composite below the next level. Since revision 0.2.1 only O, D, F and R gate; N appears only in v0.2.0 profiles.",
              "items": {
                "enum": [
                  "O",
                  "D",
                  "F",
                  "R",
                  "N"
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "head",
            "events",
            "from",
            "to"
          ],
          "properties": {
            "head": {
              "type": "string",
              "description": "Evidence head: the hash of the last event of the log the validator verified."
            },
            "events": {
              "type": "integer"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical JSON of the manifest the profile was computed against."
        },
        "independence": {
          "type": "object",
          "description": "The validator's relationship to the subject (PROTOCOL §6.1). Both flags must be false for a valid attestation.",
          "required": [
            "common_control",
            "fee_depends_on_outcome"
          ],
          "properties": {
            "common_control": {
              "const": false
            },
            "fee_depends_on_outcome": {
              "const": false
            },
            "note": {
              "type": "string",
              "description": "Anything else a relying party should know, including who pays for the attestation."
            }
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "base64url Ed25519 signature over the canonical JSON of payload."
    },
    "public_key": {
      "type": "string",
      "description": "Convenience copy of the issuer key. Never used to verify."
    }
  }
}
